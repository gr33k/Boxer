    "56.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; About-panel creator, fork, continuation and DOSBox credits; ObjectID = \"56\";",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Created by Alun Bestor.\nModern fork by MaddTheSane.\nContinued by thec0de.com.\n\nPowered by the DOSBox Team.\nReleased under GNU GPL v2."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creado por Alun Bestor.\nVersión moderna de MaddTheSane.\nContinuado por thec0de.com.\n\nBasado en DOSBox del equipo DOSBox.\nPublicado bajo GNU GPL v2."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créé par Alun Bestor.\nFork moderne par MaddTheSane.\nPoursuivi par thec0de.com.\n\nBasé sur DOSBox de l'équipe DOSBox.\nPublié sous licence GNU GPL v2."
          }
        }
      }
    },
